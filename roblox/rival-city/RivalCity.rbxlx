8247, 0.6, 248), Vector3.new(56, 0.6, 280.8597), Vector3.new(-56, 0.6, 302.1989), Vector3.new(-6.2105, 0.6, 248), Vector3.new(-56, 0.6, 293.583), Vector3.new(176.2617, 0.6, 248), Vector3.new(208, 0.6, 313.1839), Vector3.new(184.9353, 0.6, 248), Vector3.new(154.8912, 0.6, 360), Vector3.new(208, 0.6, 272.3652), Vector3.new(96, 0.6, 304.3992), Vector3.new(96, 0.6, 287.3614), Vector3.new(162.9378, 0.6, 248), Vector3.new(291.3379, 0.6, 360), Vector3.new(248, 0.6, 346.7971), Vector3.new(360, 0.6, 323.2667), Vector3.new(248, 0.6, 288.3998), Vector3.new(266.4192, 0.6, 360), Vector3.new(304.3193, 0.6, 248), Vector3.new(331.7845, 0.6, 360), Vector3.new(312.5225, 0.6, 248)},
	Showroom = {CFrame.new(-178, 1, -310), CFrame.new(-152, 1, -310), CFrame.new(-126, 1, -310)},
	ParkSpots = {CFrame.new(-171.5538, 0.3, -88) * CFrame.Angles(0, 1.5708, 0), CFrame.new(240, 0.3, -310.8924) * CFrame.Angles(0, 0, 0), CFrame.new(26.0399, 0.3, 216) * CFrame.Angles(0, 1.5708, 0), CFrame.new(-216, 0.3, -181.111) * CFrame.Angles(0, 0, 0), CFrame.new(140.2123, 0.3, 64) * CFrame.Angles(0, 1.5708, 0), CFrame.new(88, 0.3, -181.2088) * CFrame.Angles(0, 0, 0), CFrame.new(-0.1398, 0.3, 64) * CFrame.Angles(0, 1.5708, 0), CFrame.new(-216, 0.3, -133.3885) * CFrame.Angles(0, 0, 0), CFrame.new(166.3355, 0.3, -88) * CFrame.Angles(0, 1.5708, 0), CFrame.new(-216, 0.3, -292.7717) * CFrame.Angles(0, 0, 0)},
